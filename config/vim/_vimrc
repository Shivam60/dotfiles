" ============================================================
"  _vimrc  -  LeetCode/NeetCode Python setup
" ============================================================

set nocompatible
syntax on
filetype plugin indent on

" ----- Sensible defaults -----
set number              " line numbers
set ruler               " show cursor position
set showcmd
set incsearch
set hlsearch
set ignorecase
set smartcase
set backspace=indent,eol,start
set clipboard=unnamed   " yank to system clipboard (copy-paste to NeetCode)
set encoding=utf-8

" ----- Global indentation defaults -----
set autoindent
set smartindent
set expandtab           " insert spaces, never real tab characters
set tabstop=4
set shiftwidth=4
set softtabstop=4

" ============================================================
"  Python-specific: PEP8 / LeetCode friendly
"  4 spaces, no real tabs -> pastes cleanly into NeetCode
" ============================================================
augroup python_leetcode
  autocmd!
  autocmd FileType python setlocal
        \ expandtab
        \ tabstop=4
        \ shiftwidth=4
        \ softtabstop=4
        \ autoindent
        \ smartindent
        \ fileformat=unix

  " Show any stray tab characters so mixed indentation is obvious
  autocmd FileType python setlocal list listchars=tab:>-,trail:.
augroup END

" ----- Strip trailing whitespace on save (Python) -----
autocmd BufWritePre *.py %s/\s\+$//e

" ============================================================
"  Cheat Sheet side panel (right side)
" ============================================================
" expand('~') is reliable everywhere; $HOME is not always set for the
" MSYS vim that ships with Git for Windows.
let g:cheatsheet_file  = expand('~/vim-cheatsheet.txt')
let g:cheatsheet_width = 34

" Identify the panel by a buffer-local flag, not by name. Renaming the buffer to
" 'cheatsheet' fails the second time round (E95: a hidden buffer already owns
" that name), which silently broke the toggle and left duplicate splits behind.
function! s:CheatWinNr()
  for l:w in range(1, winnr('$'))
    if getbufvar(winbufnr(l:w), 'is_cheatsheet', 0)
      return l:w
    endif
  endfor
  return -1
endfunction

function! OpenCheatSheet()
  " already open? do nothing
  if s:CheatWinNr() != -1
    return
  endif
  if !filereadable(g:cheatsheet_file)
    return
  endif
  " open on the far right
  execute 'botright vertical ' . g:cheatsheet_width . 'vsplit ' . fnameescape(g:cheatsheet_file)
  " make it a fixed, non-editable helper window
  setlocal buftype=nofile bufhidden=hide noswapfile
  setlocal nomodifiable readonly
  setlocal nonumber norelativenumber nowrap
  setlocal winfixwidth nocursorline
  setlocal filetype=cheatsheet
  " Keep the friendly label without renaming the buffer: :file cheatsheet is
  " what collided on reopen. laststatus defaults to 1, so with the split open
  " each window shows its own status line anyway.
  setlocal statusline=\ cheatsheet
  let b:is_cheatsheet = 1
  " jump focus back to the editing window on the left
  wincmd h
endfunction

function! ToggleCheatSheet()
  let l:win = s:CheatWinNr()
  if l:win != -1
    execute l:win . 'wincmd c'
  else
    call OpenCheatSheet()
  endif
endfunction

command! Cheat call ToggleCheatSheet()
nnoremap <silent> <Space>c :call ToggleCheatSheet()<CR>

" Auto-open when editing a real Python file
autocmd FileType python if &buftype ==# '' | call OpenCheatSheet() | endif

" Auto-open on startup even with no file / non-python file
autocmd VimEnter * if &buftype ==# '' && !get(b:, 'is_cheatsheet', 0) | call OpenCheatSheet() | endif

" A helper panel must never keep vim alive on its own. Without this, closing the
" last real file leaves you stranded in a read-only cheat sheet that needs a
" second :q. WinEnter covers closing a split, BufEnter covers :bd on the file.
autocmd WinEnter,BufEnter * if winnr('$') == 1 && get(b:, 'is_cheatsheet', 0) | quit | endif
